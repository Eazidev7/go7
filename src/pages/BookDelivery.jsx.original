// 🗺️ ABEOKUTA BOUNDING BOX FOR SANITY CHECKS
// Define reasonable boundaries for Abeokuta delivery area
const ABEOKUTA_BOUNDS = {
  north: 7.25,    // Northern boundary
  south: 7.05,    // Southern boundary  
  east: 3.45,     // Eastern boundary
  west: 3.25      // Western boundary
};

// Helper function to round coordinates to 4 decimal places (~11m precision)
const roundCoordinates = (coords) => {
  return {
    lat: Math.round(coords.lat * 10000) / 10000,
    lng: Math.round(coords.lng * 10000) / 10000
  };
};

// Validate if coordinates are within Abeokuta delivery area
const isWithinAbeokutaBounds = (coords) => {
  const rounded = roundCoordinates(coords);
  return (
    rounded.lat >= ABEOKUTA_BOUNDS.south &&
    rounded.lat <= ABEOKUTA_BOUNDS.north &&
    rounded.lng >= ABEOKUTA_BOUNDS.west &&
    rounded.lng <= ABEOKUTA_BOUNDS.east
  );
};

// Validate both pickup and dropoff locations
const validateDeliveryArea = (pickupCoords, dropoffCoords) => {
  console.log('🔍 Validating delivery area for coordinates:', {
    pickup: roundCoordinates(pickupCoords),
    dropoff: roundCoordinates(dropoffCoords),
    bounds: ABEOKUTA_BOUNDS
  });

  const pickupValid = isWithinAbeokutaBounds(pickupCoords);
  const dropoffValid = isWithinAbeokutaBounds(dropoffCoords);

  if (!pickupValid) {
    return {
      valid: false,
      error: 'pickup',
      message: 'Pickup location seems far from Abeokuta delivery area'
    };
  }

  if (!dropoffValid) {
    return {
      valid: false,
      error: 'dropoff',
      message: 'Dropoff location seems far from Abeokuta delivery area'
    };
  }

  return { valid: true };
};


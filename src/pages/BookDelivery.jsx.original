// Haversine formula for quick distance calculation
const calculateHaversineDistance = (lat1, lon1, lat2, lon2) => {
  const R = 6371; // Earth's radius in kilometers
  const dLat = (lat2 - lat1) * Math.PI / 180;
  const dLon = (lon2 - lon1) * Math.PI / 180;
  const a =
    Math.sin(dLat / 2) * Math.sin(dLat / 2) +
    Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
    Math.sin(dLon / 2) * Math.sin(dLon / 2);
  const c = 2 * Math.asin(Math.sqrt(a));
  return R * c; // Returns distance in kilometers
};

// Quick fee estimation based on Haversine distance
const calculateQuickEstimate = (pickup, dropoff) => {
  if (!pickup || !dropoff) return null;
  const distance = calculateHaversineDistance(
    pickup[0], pickup[1],
    dropoff[0], dropoff[1]
  );
  const baseFee = 500; // ₦500 base fee
  const perKmRate = 150; // ₦150 per kilometer
  return baseFee + (distance * perKmRate);
};

// 🏗️ ENHANCED PRICING FUNCTION: Fair, zone-based dynamic pricing with distance tiers and surges
function calculateAdvancedPrice(distanceKm, isPeakHour = false, isRushHour = false) {
  // Distance-based rate tiers for fairness
  let ratePerKm = 100; // Base rate for short trips (0-5km)

  if (distanceKm > 5 && distanceKm <= 10) {
    ratePerKm = 120; // Medium distance
  } else if (distanceKm > 10 && distanceKm <= 20) {
    ratePerKm = 130; // Long distance
  } else if (distanceKm > 20) {
    ratePerKm = 140; // Very long distance
  }

  const baseFee = 500;    // Base service fee
  const serviceFee = 200; // Platform fee
  let total = baseFee + (distanceKm * ratePerKm) + serviceFee;

  // Apply surge pricing during peak hours
  if (isPeakHour) total *= 1.1;  // 10% surge for peak hours
  if (isRushHour) total *= 1.15; // 15% surge for rush hours

  return {
    baseFee,
    serviceFee,
    distanceCharge: Math.round(distanceKm * ratePerKm),
    subtotal: Math.round(baseFee + (distanceKm * ratePerKm) + serviceFee),
    total: Math.round(total),
    surgeApplied: isPeakHour || isRushHour,
    surgePercentage: isPeakHour ? 10 : (isRushHour ? 15 : 0)
  };
}

// Function to detect peak hours for surge pricing
function isPeakHour() {
  const currentHour = new Date().getHours();
  // Peak hours: 7-9 AM and 5-8 PM
  return (currentHour >= 7 && currentHour <= 9) || (currentHour >= 17 && currentHour <= 20);
}

// Function to detect rush hours (higher surge)
function isRushHour() {
  const currentHour = new Date().getHours();
  const currentDay = new Date().getDay(); // 0 = Sunday, 6 = Saturday
  // Rush hours: Friday evenings (5-8 PM) and weekend mornings (8-11 AM)
  return (currentDay === 5 && currentHour >= 17 && currentHour <= 20) ||
    ((currentDay === 0 || currentDay === 6) && currentHour >= 8 && currentHour <= 11);
}


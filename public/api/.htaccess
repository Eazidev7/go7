# Deny web access to server secrets (Hostinger Apache)
<Files "go7-secrets.php">
  Require all denied
</Files>
<IfModule mod_authz_core.c>
  <Files "go7-secrets.php">
    Require all denied
  </Files>
</IfModule>
<IfModule !mod_authz_core.c>
  <Files "go7-secrets.php">
    Order allow,deny
    Deny from all
  </Files>
</IfModule>

# Pass Authorization header through to PHP (CGI/FastCGI)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:Authorization} .
  RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

<IfModule mod_setenvif.c>
  SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

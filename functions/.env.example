# 📱 WhatsApp Business API Configuration
# Copy this file to .env and fill in your actual credentials
# NEVER commit .env to version control!

# ═══════════════════════════════════════════════════════════
# WHATSAPP CLOUD API CREDENTIALS (Official Meta API)
# ═══════════════════════════════════════════════════════════

# WhatsApp Access Token (Permanent Token from Meta Business Manager)
# Example: EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Firebase Config: firebase functions:config:set whatsapp.access_token="YOUR_TOKEN"
WHATSAPP_ACCESS_TOKEN=your_access_token_here

# WhatsApp Phone Number ID (from Meta WhatsApp Manager)
# Example: 123456789012345
# Firebase Config: firebase functions:config:set whatsapp.phone_id="YOUR_PHONE_ID"
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# ═══════════════════════════════════════════════════════════
# WHATSAPP MESSAGE TEMPLATES (Must match approved template names)
# ═══════════════════════════════════════════════════════════

# Template for CONFIRMED status
# Default: "Hi {{1}}, your order {{2}} has been confirmed..."
# Firebase Config: firebase functions:config:set whatsapp.template_confirmed="go7_confirmed"
TEMPLATE_CONFIRMED=go7_confirmed

# Template for OUT_FOR_DELIVERY status
# Default: "Your order {{1}} is on the way..."
# Firebase Config: firebase functions:config:set whatsapp.template_out_for_delivery="go7_out_for_delivery"
TEMPLATE_OUT_FOR_DELIVERY=go7_out_for_delivery

# Template for DELIVERED status
# Default: "Order {{1}} has been delivered successfully..."
# Firebase Config: firebase functions:config:set whatsapp.template_delivered="go7_delivered"
TEMPLATE_DELIVERED=go7_delivered

# ═══════════════════════════════════════════════════════════
# GO7 CONFIGURATION
# ═══════════════════════════════════════════════════════════

# Go7 Support WhatsApp Number (for "Contact Support" button)
# Format: Country code + number (e.g., 2348012345678)
# Firebase Config: firebase functions:config:set whatsapp.support_number="2348012345678"
GO7_SUPPORT_NUMBER=2348012345678

# Webhook Verification Token (for Meta webhook setup)
# Choose a secure random string
# Firebase Config: firebase functions:config:set whatsapp.verify_token="GO7_WEBHOOK_2025"
WHATSAPP_VERIFY_TOKEN=GO7_WEBHOOK_2025

# ═══════════════════════════════════════════════════════════
# LEGACY WHATSAPP BUSINESS API (Template-based notifications)
# For backward compatibility with whatsappNotifications.js
# ═══════════════════════════════════════════════════════════

# WhatsApp Phone Number ID (from Meta Business Manager)
# Example: 123456789012345
# Firebase Config: firebase functions:config:set whatsapp.phone_id="YOUR_PHONE_ID"
WHATSAPP_PHONE_ID=your_phone_number_id_here

# Meta Access Token (Permanent Token with whatsapp_business_messaging permission)
# Example: EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Firebase Config: firebase functions:config:set whatsapp.meta_token="YOUR_TOKEN"
META_TOKEN=your_meta_access_token_here

# ═══════════════════════════════════════════════════════════
# CONFIGURATION PRIORITY
# ═══════════════════════════════════════════════════════════
# The code loads configuration in this order:
# 1. process.env (from .env file - local development)
# 2. functions.config() (from Firebase - production)
# 3. Default values (fallback)
#
# For production deployment, use Firebase Functions config:
#   firebase functions:config:set whatsapp.access_token="YOUR_TOKEN"
#   firebase functions:config:set whatsapp.phone_id="YOUR_PHONE_ID"
#   etc.
#
# For local development, use this .env file
# ═══════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════
# How to set up:
# 1. Copy this file: cp .env.example .env
# 2. Edit .env with your actual credentials
# 3. For local testing, start Firebase emulator
# 4. For production, use Firebase CLI commands above
# 5. Never commit .env to version control!
# ═══════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════
# SME API (smeapi.com.ng) - Bills/VTU: airtime + data bundles
# https://www.smeapi.com.ng/apidocumentation.html
# ═══════════════════════════════════════════════════════════
SMEAPI_KEY=your_smeapi_key_here

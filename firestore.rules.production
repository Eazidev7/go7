rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read access to basic delivery data
    match /deliveries/{deliveryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Real-time rider tracking
    match /riders/{riderId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Live rider locations
    match /rider-locations/{riderId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Order tracking
    match /orders/{orderId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Bookings collection
    match /bookings/{bookingId} {
      allow read: if true;
      allow write: if true; // Allow anonymous booking
    }
    
    // Customer tracking data
    match /customer-tracking/{trackingId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Real-time chat/messaging
    match /delivery-chat/{chatId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Admin dashboard data
    match /admin-stats/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
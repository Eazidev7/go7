{
  "name": "go7",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" vite --host 0.0.0.0 --port 3000",
    "dev:direct": "vite --host 0.0.0.0 --port 3000 --clearScreen false",
    "dev:startup": "cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" node dev-startup.cjs",
    "dev:vite": "cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" vite --host localhost --port 3000 --force",
    "dev:fallback": "cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" node fallback-server.cjs",
    "dev:fast": "cross-env NODE_OPTIONS=\"--max-old-space-size=4096 --max-semi-space-size=256\" vite --host --force --no-open",
    "dev:stable": "cross-env NODE_OPTIONS=\"--max-old-space-size=6144 --max-semi-space-size=512 --expose-gc\" vite --host --force --logLevel info",
    "dev:optimized": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" vite --host --force",
    "dev:safe": "taskkill /F /IM node.exe 2>nul && timeout /t 3 /nobreak >nul && npm run dev:stable",
    "build": "node scripts/patch-figma-app.mjs && node scripts/patch-figma-app-phase2.mjs && node scripts/patch-figma-app-phase3.mjs && node scripts/patch-ios-perf.mjs && vite build && node scripts/postbuild-spa-fallbacks.cjs",
    "sync:firebase-keys": "node src/utils/syncFirebaseKeys.mjs",
    "cap:sync": "npm run build && npx cap sync android",
    "build:android": "npm run cap:sync",
    "android:open": "npx cap open android",
    "android:run": "npm run cap:sync && npx cap run android",
    "vendor:cap:config": "node -e \"console.log('GO7 Vendor Capacitor config: capacitor.vendor.config.json\\nApp id: ng.go7.vendor\\nSee docs/VENDOR_APP.md')\"",
    "deploy:hostinger": "node scripts/deploy-hostinger.mjs",
    "video:record": "node scripts/marketing-video/record-flow.mjs",
    "video:polish": "node scripts/marketing-video/polish-video.mjs",
    "video:marketing": "node scripts/marketing-video/record-flow.mjs && node scripts/marketing-video/polish-video.mjs",
    "video:install-browsers": "playwright install chromium",
    "docs:menu-pdf": "node scripts/generate-menu-onboarding-pdf.mjs",
    "deploy:storage": "firebase deploy --only storage",
    "storage:cors": "node scripts/setup-storage-cors.mjs",
    "preview": "vite preview --port 4173",
    "dev:clean": "rimraf .vite_cache && vite --force --open",
    "mobile": "node mobile-server.mjs",
    "dev:mobile": "cross-env GO7_HTTPS=1 NODE_OPTIONS=\"--max-old-space-size=4096\" vite --host 0.0.0.0 --port 3000",
    "clean-cache": "rimraf node_modules/.vite node_modules/.cache dist .vite_cache && echo Cache cleared successfully!",
    "test": "echo 'Tests configured but require Firebase emulator setup'",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:migration": "jest scripts/migrate_v1_to_v2.test.ts",
    "fix-firebase": "node firebase-config-fixer.js",
    "test-fcm": "node test-fcm.js",
    "build:staging": "cross-env VITE_ENV=staging vite build",
    "functions:dev": "cd functions && npm run serve",
    "functions:deploy": "cd functions && npm run deploy",
    "functions:build": "cd functions && npm run build",
    "functions:install": "cd functions && npm install",
    "clean": "rimraf .vite_cache node_modules/.vite",
    "restart": "taskkill /F /IM node.exe 2>nul || echo No Node processes found && npm run dev:stable",
    "dev:monitor": "cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" nodemon --exec \"npm run dev:stable\" --watch package.json --watch vite.config.js --ignore node_modules/ --ignore dist/",
    "kill-dev": "taskkill /F /IM node.exe 2>nul && taskkill /F /IM vite.exe 2>nul || echo All dev processes killed"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@google-cloud/storage": "^7.21.0",
    "@sentry/vite-plugin": "^4.3.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.20",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.8",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "autoprefixer": "^10.4.21",
    "basic-ftp": "^5.3.1",
    "cross-env": "^7.0.3",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.3.0",
    "firebase-admin": "^13.6.0",
    "google-auth-library": "^10.4.2",
    "http-proxy-middleware": "^3.0.5",
    "jest": "^30.1.1",
    "playwright": "^1.61.1",
    "postcss": "^8.5.6",
    "rimraf": "^6.0.1",
    "sass": "^1.94.0",
    "sass-embedded": "^1.93.3",
    "tailwindcss": "^3.3.5",
    "ts-jest": "^29.4.1",
    "vite": "^7.3.5",
    "vite-plugin-pwa": "^1.0.2"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/status-bar": "^8.0.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@googlemaps/js-api-loader": "^2.0.1",
    "@headlessui/react": "^2.2.7",
    "@hello-pangea/dnd": "^18.0.1",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.2.1",
    "@maplibre/maplibre-gl-style-spec": "^24.2.0",
    "@maptiler/sdk": "^3.8.0",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "@paystack/inline-js": "^2.22.7",
    "@radix-ui/react-icons": "^1.3.2",
    "@react-google-maps/api": "^2.20.7",
    "@sentry/react": "^7.120.4",
    "@sentry/tracing": "^7.120.4",
    "@tanstack/react-query": "^5.90.8",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "animate.css": "^4.1.1",
    "axios": "^1.12.2",
    "canvas-confetti": "^1.9.3",
    "capacitor-google-navigation": "^0.2.2",
    "chart.js": "^4.5.0",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.18",
    "dompurify": "^3.3.1",
    "express-rate-limit": "^8.2.1",
    "firebase": "^12.1.0",
    "framer-motion": "^12.23.25",
    "google-map-react": "^2.2.5",
    "helmet": "^8.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "leaflet-ant-path": "^1.3.0",
    "leaflet-rotatedmarker": "^0.2.0",
    "leaflet-routing-machine": "^3.2.12",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.544.0",
    "maplibre-gl": "^5.7.0",
    "motion": "^12.23.25",
    "pigeon-maps": "^0.22.1",
    "prop-types": "^15.8.1",
    "puppeteer": "^24.35.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.2.0",
    "react-firebase-hooks": "^5.1.1",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.62.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.5.0",
    "react-leaflet": "^4.2.1",
    "react-paystack": "^6.0.0",
    "react-router-dom": "^7.8.1",
    "recharts": "^3.4.1",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.3",
    "styled-map": "^3.3.0",
    "styled-map-package": "^3.0.0",
    "sweetalert2": "^11.26.3",
    "toastify-js": "^1.12.0",
    "uuid": "^12.0.0",
    "validator": "^13.15.26",
    "workbox-window": "^7.3.0",
    "zod": "^4.1.1",
    "zustand": "^5.0.8"
  }
}
